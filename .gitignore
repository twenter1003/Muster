node_modules/
dist/
coverage/
.env
.env.*
!.env.example
*.log
.DS_Store
.secrets/
.secrets-test/

# Claude Code 훅(scripts/claude-code-hooks)이 이 레포를 Muster로 추적할 때 쓰는 로컬
# 설정 — API 키 원문이 들어간다 (docs/AGENT_TOKEN_REPORTING.md).
.muster/

# tsc --build가 남기는 증분 빌드 캐시. 빌드할 때마다 바뀌는 산출물이라 추적하면
# 관계없는 PR마다 diff에 끼어들고, 커밋 사이에 충돌까지 낸다.
*.tsbuildinfo

# 시드된 캔버스 페이지는 에디터 런타임 2MB가 통째로 들어간 산출물이다.
# 아트보드(.dc.html)와 canvas.json만 원본이고, 이 파일은 거기서 다시 만든다.
muster-user-guide.html

# graphify 산출물
graphify-out/

# .claude는 기본적으로 제외하되, "이 프로젝트를 아는 지식"은 추적한다 — 기기마다 다시
# 만들 이유가 없다. 디렉터리(.claude/)가 아니라 내용물(.claude/*)을 제외해야 한다:
# 디렉터리를 통째로 무시하면 git이 그 안으로 들어가지 않아 아래 예외가 먹지 않는다.
# 제외로 남는 것: settings.json(훅·권한 등 기기별 설정), worktrees/.
.claude/*
!.claude/launch.json
!.claude/agents/
