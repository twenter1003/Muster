# 로컬 개발용 값만 둔다. 실제 시크릿은 GCP Secret Manager에서 주입한다 (TechSpec 6.2).
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://muster:muster@localhost:5432/muster

# Phase 3에서 사용
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Phase 3
OAUTH_STATE_SECRET=dev-only-oauth-state-secret-change-me
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
# file | gcp. gcp는 GCP Secret Manager를 쓰며 GCP_PROJECT_ID가 있어야 한다.
# 저장소를 바꾸면 이전 저장소가 발급한 참조(file:// ↔ gcp://)는 읽히지 않는다.
SECRETS_BACKEND=file
SECRETS_DIR=.secrets

# Vertex AI(ADC) 경로가 쓰는 프로젝트 id. GEMINI_API_KEY가 있으면 필요 없다.
GCP_PROJECT_ID=

# LLM(Gemini). 기본은 Gemini API(generateContent)를 키로 직접 부르는 것이다.
# 키가 비어 있으면 Vertex AI로 넘어간다 (ADC 인증, GCP_PROJECT_ID 사용).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
