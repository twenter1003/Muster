# 로컬 개발용 값만 둔다. 실제 시크릿은 GCP Secret Manager에서 주입한다 (TechSpec 6.2).
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://muster:muster@localhost:5432/muster

# Phase 3에서 사용
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Phase 3
OAUTH_STATE_SECRET=dev-only-oauth-state-secret-change-me
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
SECRETS_DIR=.secrets

# Phase 4 — DocStore (scripts/setup-gcs.sh가 출력하는 값)
GCS_BUCKET=
GCP_PROJECT_ID=
# 로컬에서만 필요하다 (setup-gcs.sh가 만드는 muster-api@<프로젝트>.iam.gserviceaccount.com).
# Cloud Run에서는 비워 둔다.
GCS_SIGNER_SERVICE_ACCOUNT=
